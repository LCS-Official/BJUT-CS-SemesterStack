// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "11/18/2024 22:35:51"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    button
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module button_vlg_sample_tst(
	clk,
	swc,
	sampler_tx
);
input  clk;
input [3:0] swc;
output sampler_tx;

reg sample;
time current_time;
always @(clk or swc)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module button_vlg_check_tst (
	key,
	swr0,
	swr1,
	swr2,
	swr3,
	sampler_rx
);
input [3:0] key;
input  swr0;
input  swr1;
input  swr2;
input  swr3;
input sampler_rx;

reg [3:0] key_expected;
reg  swr0_expected;
reg  swr1_expected;
reg  swr2_expected;
reg  swr3_expected;

reg [3:0] key_prev;
reg  swr0_prev;
reg  swr1_prev;
reg  swr2_prev;
reg  swr3_prev;

reg [3:0] key_expected_prev;
reg  swr0_expected_prev;
reg  swr1_expected_prev;
reg  swr2_expected_prev;
reg  swr3_expected_prev;

reg [3:0] last_key_exp;
reg  last_swr0_exp;
reg  last_swr1_exp;
reg  last_swr2_exp;
reg  last_swr3_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:5] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 5'b1;
end

// update real /o prevs

always @(trigger)
begin
	key_prev = key;
	swr0_prev = swr0;
	swr1_prev = swr1;
	swr2_prev = swr2;
	swr3_prev = swr3;
end

// update expected /o prevs

always @(trigger)
begin
	key_expected_prev = key_expected;
	swr0_expected_prev = swr0_expected;
	swr1_expected_prev = swr1_expected;
	swr2_expected_prev = swr2_expected;
	swr3_expected_prev = swr3_expected;
end


// expected key[ 3 ]
initial
begin
	key_expected[3] = 1'bX;
end 
// expected key[ 2 ]
initial
begin
	key_expected[2] = 1'bX;
end 
// expected key[ 1 ]
initial
begin
	key_expected[1] = 1'bX;
end 
// expected key[ 0 ]
initial
begin
	key_expected[0] = 1'bX;
end 

// expected swr0
initial
begin
	swr0_expected = 1'bX;
end 

// expected swr1
initial
begin
	swr1_expected = 1'bX;
end 

// expected swr2
initial
begin
	swr2_expected = 1'bX;
end 

// expected swr3
initial
begin
	swr3_expected = 1'bX;
end 
// generate trigger
always @(key_expected or key or swr0_expected or swr0 or swr1_expected or swr1 or swr2_expected or swr2 or swr3_expected or swr3)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected key = %b | expected swr0 = %b | expected swr1 = %b | expected swr2 = %b | expected swr3 = %b | ",key_expected_prev,swr0_expected_prev,swr1_expected_prev,swr2_expected_prev,swr3_expected_prev);
	$display("| real key = %b | real swr0 = %b | real swr1 = %b | real swr2 = %b | real swr3 = %b | ",key_prev,swr0_prev,swr1_prev,swr2_prev,swr3_prev);
`endif
	if (
		( key_expected_prev[0] !== 1'bx ) && ( key_prev[0] !== key_expected_prev[0] )
		&& ((key_expected_prev[0] !== last_key_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port key[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", key_expected_prev);
		$display ("     Real value = %b", key_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_key_exp[0] = key_expected_prev[0];
	end
	if (
		( key_expected_prev[1] !== 1'bx ) && ( key_prev[1] !== key_expected_prev[1] )
		&& ((key_expected_prev[1] !== last_key_exp[1]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port key[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", key_expected_prev);
		$display ("     Real value = %b", key_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_key_exp[1] = key_expected_prev[1];
	end
	if (
		( key_expected_prev[2] !== 1'bx ) && ( key_prev[2] !== key_expected_prev[2] )
		&& ((key_expected_prev[2] !== last_key_exp[2]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port key[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", key_expected_prev);
		$display ("     Real value = %b", key_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_key_exp[2] = key_expected_prev[2];
	end
	if (
		( key_expected_prev[3] !== 1'bx ) && ( key_prev[3] !== key_expected_prev[3] )
		&& ((key_expected_prev[3] !== last_key_exp[3]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port key[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", key_expected_prev);
		$display ("     Real value = %b", key_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_key_exp[3] = key_expected_prev[3];
	end
	if (
		( swr0_expected_prev !== 1'bx ) && ( swr0_prev !== swr0_expected_prev )
		&& ((swr0_expected_prev !== last_swr0_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port swr0 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", swr0_expected_prev);
		$display ("     Real value = %b", swr0_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_swr0_exp = swr0_expected_prev;
	end
	if (
		( swr1_expected_prev !== 1'bx ) && ( swr1_prev !== swr1_expected_prev )
		&& ((swr1_expected_prev !== last_swr1_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port swr1 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", swr1_expected_prev);
		$display ("     Real value = %b", swr1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_swr1_exp = swr1_expected_prev;
	end
	if (
		( swr2_expected_prev !== 1'bx ) && ( swr2_prev !== swr2_expected_prev )
		&& ((swr2_expected_prev !== last_swr2_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port swr2 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", swr2_expected_prev);
		$display ("     Real value = %b", swr2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_swr2_exp = swr2_expected_prev;
	end
	if (
		( swr3_expected_prev !== 1'bx ) && ( swr3_prev !== swr3_expected_prev )
		&& ((swr3_expected_prev !== last_swr3_exp) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port swr3 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", swr3_expected_prev);
		$display ("     Real value = %b", swr3_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_swr3_exp = swr3_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module button_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg [3:0] swc;
// wires                                               
wire [3:0] key;
wire swr0;
wire swr1;
wire swr2;
wire swr3;

wire sampler;                             

// assign statements (if any)                          
button i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.key(key),
	.swc(swc),
	.swr0(swr0),
	.swr1(swr1),
	.swr2(swr2),
	.swr3(swr3)
);

// clk
always
begin
	clk = 1'b0;
	clk = #10000 1'b1;
	#10000;
end 
// swc[ 3 ]
initial
begin
	repeat(3)
	begin
		swc[3] = 1'b0;
		swc[3] = #160000 1'b1;
		# 160000;
	end
	swc[3] = 1'b0;
end 
// swc[ 2 ]
initial
begin
	repeat(6)
	begin
		swc[2] = 1'b0;
		swc[2] = #80000 1'b1;
		# 80000;
	end
	swc[2] = 1'b0;
end 
// swc[ 1 ]
initial
begin
	repeat(12)
	begin
		swc[1] = 1'b0;
		swc[1] = #40000 1'b1;
		# 40000;
	end
	swc[1] = 1'b0;
end 
// swc[ 0 ]
always
begin
	swc[0] = 1'b0;
	swc[0] = #20000 1'b1;
	#20000;
end 

button_vlg_sample_tst tb_sample (
	.clk(clk),
	.swc(swc),
	.sampler_tx(sampler)
);

button_vlg_check_tst tb_out(
	.key(key),
	.swr0(swr0),
	.swr1(swr1),
	.swr2(swr2),
	.swr3(swr3),
	.sampler_rx(sampler)
);
endmodule

