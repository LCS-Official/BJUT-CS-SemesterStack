// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "11/13/2024 19:27:04"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    keyboard_recognition_top
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module keyboard_recognition_top_vlg_sample_tst(
	clk_50mhz,
	frequency_n_rst,
	keyboard_rst,
	keyboard_swc,
	LED_n_en,
	sampler_tx
);
input  clk_50mhz;
input  frequency_n_rst;
input  keyboard_rst;
input [3:0] keyboard_swc;
input  LED_n_en;
output sampler_tx;

reg sample;
time current_time;
always @(clk_50mhz or frequency_n_rst or keyboard_rst or keyboard_swc or LED_n_en)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module keyboard_recognition_top_vlg_check_tst (
	keyboard_flag,
	keyboard_swr,
	LED_out,
	sampler_rx
);
input  keyboard_flag;
input [3:0] keyboard_swr;
input [6:0] LED_out;
input sampler_rx;

reg  keyboard_flag_expected;
reg [3:0] keyboard_swr_expected;
reg [6:0] LED_out_expected;

reg  keyboard_flag_prev;
reg [3:0] keyboard_swr_prev;
reg [6:0] LED_out_prev;

reg  keyboard_flag_expected_prev;
reg [3:0] keyboard_swr_expected_prev;
reg [6:0] LED_out_expected_prev;

reg  last_keyboard_flag_exp;
reg [3:0] last_keyboard_swr_exp;
reg [6:0] last_LED_out_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:3] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 3'b1;
end

// update real /o prevs

always @(trigger)
begin
	keyboard_flag_prev = keyboard_flag;
	keyboard_swr_prev = keyboard_swr;
	LED_out_prev = LED_out;
end

// update expected /o prevs

always @(trigger)
begin
	keyboard_flag_expected_prev = keyboard_flag_expected;
	keyboard_swr_expected_prev = keyboard_swr_expected;
	LED_out_expected_prev = LED_out_expected;
end


// expected keyboard_swr[ 3 ]
initial
begin
	keyboard_swr_expected[3] = 1'bX;
end 
// expected keyboard_swr[ 2 ]
initial
begin
	keyboard_swr_expected[2] = 1'bX;
end 
// expected keyboard_swr[ 1 ]
initial
begin
	keyboard_swr_expected[1] = 1'bX;
end 
// expected keyboard_swr[ 0 ]
initial
begin
	keyboard_swr_expected[0] = 1'bX;
end 
// expected LED_out[ 6 ]
initial
begin
	LED_out_expected[6] = 1'bX;
end 
// expected LED_out[ 5 ]
initial
begin
	LED_out_expected[5] = 1'bX;
end 
// expected LED_out[ 4 ]
initial
begin
	LED_out_expected[4] = 1'bX;
end 
// expected LED_out[ 3 ]
initial
begin
	LED_out_expected[3] = 1'bX;
end 
// expected LED_out[ 2 ]
initial
begin
	LED_out_expected[2] = 1'bX;
end 
// expected LED_out[ 1 ]
initial
begin
	LED_out_expected[1] = 1'bX;
end 
// expected LED_out[ 0 ]
initial
begin
	LED_out_expected[0] = 1'bX;
end 

// expected keyboard_flag
initial
begin
	keyboard_flag_expected = 1'bX;
end 
// generate trigger
always @(keyboard_flag_expected or keyboard_flag or keyboard_swr_expected or keyboard_swr or LED_out_expected or LED_out)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected keyboard_flag = %b | expected keyboard_swr = %b | expected LED_out = %b | ",keyboard_flag_expected_prev,keyboard_swr_expected_prev,LED_out_expected_prev);
	$display("| real keyboard_flag = %b | real keyboard_swr = %b | real LED_out = %b | ",keyboard_flag_prev,keyboard_swr_prev,LED_out_prev);
`endif
	if (
		( keyboard_flag_expected_prev !== 1'bx ) && ( keyboard_flag_prev !== keyboard_flag_expected_prev )
		&& ((keyboard_flag_expected_prev !== last_keyboard_flag_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port keyboard_flag :: @time = %t",  $realtime);
		$display ("     Expected value = %b", keyboard_flag_expected_prev);
		$display ("     Real value = %b", keyboard_flag_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_keyboard_flag_exp = keyboard_flag_expected_prev;
	end
	if (
		( keyboard_swr_expected_prev[0] !== 1'bx ) && ( keyboard_swr_prev[0] !== keyboard_swr_expected_prev[0] )
		&& ((keyboard_swr_expected_prev[0] !== last_keyboard_swr_exp[0]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port keyboard_swr[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", keyboard_swr_expected_prev);
		$display ("     Real value = %b", keyboard_swr_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_keyboard_swr_exp[0] = keyboard_swr_expected_prev[0];
	end
	if (
		( keyboard_swr_expected_prev[1] !== 1'bx ) && ( keyboard_swr_prev[1] !== keyboard_swr_expected_prev[1] )
		&& ((keyboard_swr_expected_prev[1] !== last_keyboard_swr_exp[1]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port keyboard_swr[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", keyboard_swr_expected_prev);
		$display ("     Real value = %b", keyboard_swr_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_keyboard_swr_exp[1] = keyboard_swr_expected_prev[1];
	end
	if (
		( keyboard_swr_expected_prev[2] !== 1'bx ) && ( keyboard_swr_prev[2] !== keyboard_swr_expected_prev[2] )
		&& ((keyboard_swr_expected_prev[2] !== last_keyboard_swr_exp[2]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port keyboard_swr[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", keyboard_swr_expected_prev);
		$display ("     Real value = %b", keyboard_swr_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_keyboard_swr_exp[2] = keyboard_swr_expected_prev[2];
	end
	if (
		( keyboard_swr_expected_prev[3] !== 1'bx ) && ( keyboard_swr_prev[3] !== keyboard_swr_expected_prev[3] )
		&& ((keyboard_swr_expected_prev[3] !== last_keyboard_swr_exp[3]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port keyboard_swr[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", keyboard_swr_expected_prev);
		$display ("     Real value = %b", keyboard_swr_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_keyboard_swr_exp[3] = keyboard_swr_expected_prev[3];
	end
	if (
		( LED_out_expected_prev[0] !== 1'bx ) && ( LED_out_prev[0] !== LED_out_expected_prev[0] )
		&& ((LED_out_expected_prev[0] !== last_LED_out_exp[0]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LED_out[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LED_out_expected_prev);
		$display ("     Real value = %b", LED_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_LED_out_exp[0] = LED_out_expected_prev[0];
	end
	if (
		( LED_out_expected_prev[1] !== 1'bx ) && ( LED_out_prev[1] !== LED_out_expected_prev[1] )
		&& ((LED_out_expected_prev[1] !== last_LED_out_exp[1]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LED_out[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LED_out_expected_prev);
		$display ("     Real value = %b", LED_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_LED_out_exp[1] = LED_out_expected_prev[1];
	end
	if (
		( LED_out_expected_prev[2] !== 1'bx ) && ( LED_out_prev[2] !== LED_out_expected_prev[2] )
		&& ((LED_out_expected_prev[2] !== last_LED_out_exp[2]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LED_out[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LED_out_expected_prev);
		$display ("     Real value = %b", LED_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_LED_out_exp[2] = LED_out_expected_prev[2];
	end
	if (
		( LED_out_expected_prev[3] !== 1'bx ) && ( LED_out_prev[3] !== LED_out_expected_prev[3] )
		&& ((LED_out_expected_prev[3] !== last_LED_out_exp[3]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LED_out[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LED_out_expected_prev);
		$display ("     Real value = %b", LED_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_LED_out_exp[3] = LED_out_expected_prev[3];
	end
	if (
		( LED_out_expected_prev[4] !== 1'bx ) && ( LED_out_prev[4] !== LED_out_expected_prev[4] )
		&& ((LED_out_expected_prev[4] !== last_LED_out_exp[4]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LED_out[4] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LED_out_expected_prev);
		$display ("     Real value = %b", LED_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_LED_out_exp[4] = LED_out_expected_prev[4];
	end
	if (
		( LED_out_expected_prev[5] !== 1'bx ) && ( LED_out_prev[5] !== LED_out_expected_prev[5] )
		&& ((LED_out_expected_prev[5] !== last_LED_out_exp[5]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LED_out[5] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LED_out_expected_prev);
		$display ("     Real value = %b", LED_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_LED_out_exp[5] = LED_out_expected_prev[5];
	end
	if (
		( LED_out_expected_prev[6] !== 1'bx ) && ( LED_out_prev[6] !== LED_out_expected_prev[6] )
		&& ((LED_out_expected_prev[6] !== last_LED_out_exp[6]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LED_out[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LED_out_expected_prev);
		$display ("     Real value = %b", LED_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_LED_out_exp[6] = LED_out_expected_prev[6];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#2000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$stop;
end 
endmodule

module keyboard_recognition_top_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk_50mhz;
reg frequency_n_rst;
reg keyboard_rst;
reg [3:0] keyboard_swc;
reg LED_n_en;
// wires                                               
wire keyboard_flag;
wire [3:0] keyboard_swr;
wire [6:0] LED_out;

wire sampler;                             

// assign statements (if any)                          
keyboard_recognition_top i1 (
// port map - connection between master ports and signals/registers   
	.clk_50mhz(clk_50mhz),
	.frequency_n_rst(frequency_n_rst),
	.keyboard_flag(keyboard_flag),
	.keyboard_rst(keyboard_rst),
	.keyboard_swc(keyboard_swc),
	.keyboard_swr(keyboard_swr),
	.LED_n_en(LED_n_en),
	.LED_out(LED_out)
);

// clk_50mhz
always
begin
	clk_50mhz = 1'b0;
	clk_50mhz = #10000 1'b1;
	#10000;
end 

// frequency_n_rst
initial
begin
	frequency_n_rst = 1'b1;
	frequency_n_rst = #800000 1'b0;
	frequency_n_rst = #300000 1'b1;
end 

// keyboard_rst
initial
begin
	keyboard_rst = 1'b0;
	keyboard_rst = #1300000 1'b1;
	keyboard_rst = #300000 1'b0;
end 

// LED_n_en
initial
begin
	LED_n_en = 1'b0;
	LED_n_en = #1700000 1'b1;
end 
// keyboard_swc[ 3 ]
initial
begin
	keyboard_swc[3] = 1'b1;
end 
// keyboard_swc[ 2 ]
initial
begin
	keyboard_swc[2] = 1'b1;
end 
// keyboard_swc[ 1 ]
initial
begin
	keyboard_swc[1] = 1'b1;
	keyboard_swc[1] = #800000 1'b0;
	keyboard_swc[1] = #150000 1'b1;
	keyboard_swc[1] = #350000 1'b0;
	keyboard_swc[1] = #150000 1'b1;
end 
// keyboard_swc[ 0 ]
initial
begin
	keyboard_swc[0] = 1'b1;
	keyboard_swc[0] = #200000 1'b0;
	keyboard_swc[0] = #600000 1'b1;
end 

keyboard_recognition_top_vlg_sample_tst tb_sample (
	.clk_50mhz(clk_50mhz),
	.frequency_n_rst(frequency_n_rst),
	.keyboard_rst(keyboard_rst),
	.keyboard_swc(keyboard_swc),
	.LED_n_en(LED_n_en),
	.sampler_tx(sampler)
);

keyboard_recognition_top_vlg_check_tst tb_out(
	.keyboard_flag(keyboard_flag),
	.keyboard_swr(keyboard_swr),
	.LED_out(LED_out),
	.sampler_rx(sampler)
);
endmodule

