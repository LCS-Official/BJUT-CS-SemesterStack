// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "11/13/2024 20:47:43"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    keyboard_recognition
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module keyboard_recognition_vlg_sample_tst(
	clk,
	reset,
	swc,
	sampler_tx
);
input  clk;
input  reset;
input [3:0] swc;
output sampler_tx;

reg sample;
time current_time;
always @(clk or reset or swc)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module keyboard_recognition_vlg_check_tst (
	flag,
	keyout,
	swr,
	sampler_rx
);
input  flag;
input [3:0] keyout;
input [3:0] swr;
input sampler_rx;

reg  flag_expected;
reg [3:0] keyout_expected;
reg [3:0] swr_expected;

reg  flag_prev;
reg [3:0] keyout_prev;
reg [3:0] swr_prev;

reg  flag_expected_prev;
reg [3:0] keyout_expected_prev;
reg [3:0] swr_expected_prev;

reg  last_flag_exp;
reg [3:0] last_keyout_exp;
reg [3:0] last_swr_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:3] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 3'b1;
end

// update real /o prevs

always @(trigger)
begin
	flag_prev = flag;
	keyout_prev = keyout;
	swr_prev = swr;
end

// update expected /o prevs

always @(trigger)
begin
	flag_expected_prev = flag_expected;
	keyout_expected_prev = keyout_expected;
	swr_expected_prev = swr_expected;
end


// expected swr[ 3 ]
initial
begin
	swr_expected[3] = 1'bX;
end 
// expected swr[ 2 ]
initial
begin
	swr_expected[2] = 1'bX;
end 
// expected swr[ 1 ]
initial
begin
	swr_expected[1] = 1'bX;
end 
// expected swr[ 0 ]
initial
begin
	swr_expected[0] = 1'bX;
end 
// expected keyout[ 3 ]
initial
begin
	keyout_expected[3] = 1'bX;
end 
// expected keyout[ 2 ]
initial
begin
	keyout_expected[2] = 1'bX;
end 
// expected keyout[ 1 ]
initial
begin
	keyout_expected[1] = 1'bX;
end 
// expected keyout[ 0 ]
initial
begin
	keyout_expected[0] = 1'bX;
end 

// expected flag
initial
begin
	flag_expected = 1'bX;
end 
// generate trigger
always @(flag_expected or flag or keyout_expected or keyout or swr_expected or swr)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected flag = %b | expected keyout = %b | expected swr = %b | ",flag_expected_prev,keyout_expected_prev,swr_expected_prev);
	$display("| real flag = %b | real keyout = %b | real swr = %b | ",flag_prev,keyout_prev,swr_prev);
`endif
	if (
		( flag_expected_prev !== 1'bx ) && ( flag_prev !== flag_expected_prev )
		&& ((flag_expected_prev !== last_flag_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port flag :: @time = %t",  $realtime);
		$display ("     Expected value = %b", flag_expected_prev);
		$display ("     Real value = %b", flag_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_flag_exp = flag_expected_prev;
	end
	if (
		( keyout_expected_prev[0] !== 1'bx ) && ( keyout_prev[0] !== keyout_expected_prev[0] )
		&& ((keyout_expected_prev[0] !== last_keyout_exp[0]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port keyout[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", keyout_expected_prev);
		$display ("     Real value = %b", keyout_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_keyout_exp[0] = keyout_expected_prev[0];
	end
	if (
		( keyout_expected_prev[1] !== 1'bx ) && ( keyout_prev[1] !== keyout_expected_prev[1] )
		&& ((keyout_expected_prev[1] !== last_keyout_exp[1]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port keyout[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", keyout_expected_prev);
		$display ("     Real value = %b", keyout_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_keyout_exp[1] = keyout_expected_prev[1];
	end
	if (
		( keyout_expected_prev[2] !== 1'bx ) && ( keyout_prev[2] !== keyout_expected_prev[2] )
		&& ((keyout_expected_prev[2] !== last_keyout_exp[2]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port keyout[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", keyout_expected_prev);
		$display ("     Real value = %b", keyout_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_keyout_exp[2] = keyout_expected_prev[2];
	end
	if (
		( keyout_expected_prev[3] !== 1'bx ) && ( keyout_prev[3] !== keyout_expected_prev[3] )
		&& ((keyout_expected_prev[3] !== last_keyout_exp[3]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port keyout[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", keyout_expected_prev);
		$display ("     Real value = %b", keyout_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_keyout_exp[3] = keyout_expected_prev[3];
	end
	if (
		( swr_expected_prev[0] !== 1'bx ) && ( swr_prev[0] !== swr_expected_prev[0] )
		&& ((swr_expected_prev[0] !== last_swr_exp[0]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port swr[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", swr_expected_prev);
		$display ("     Real value = %b", swr_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_swr_exp[0] = swr_expected_prev[0];
	end
	if (
		( swr_expected_prev[1] !== 1'bx ) && ( swr_prev[1] !== swr_expected_prev[1] )
		&& ((swr_expected_prev[1] !== last_swr_exp[1]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port swr[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", swr_expected_prev);
		$display ("     Real value = %b", swr_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_swr_exp[1] = swr_expected_prev[1];
	end
	if (
		( swr_expected_prev[2] !== 1'bx ) && ( swr_prev[2] !== swr_expected_prev[2] )
		&& ((swr_expected_prev[2] !== last_swr_exp[2]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port swr[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", swr_expected_prev);
		$display ("     Real value = %b", swr_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_swr_exp[2] = swr_expected_prev[2];
	end
	if (
		( swr_expected_prev[3] !== 1'bx ) && ( swr_prev[3] !== swr_expected_prev[3] )
		&& ((swr_expected_prev[3] !== last_swr_exp[3]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port swr[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", swr_expected_prev);
		$display ("     Real value = %b", swr_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_swr_exp[3] = swr_expected_prev[3];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#2000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module keyboard_recognition_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg reset;
reg [3:0] swc;
// wires                                               
wire flag;
wire [3:0] keyout;
wire [3:0] swr;

wire sampler;                             

// assign statements (if any)                          
keyboard_recognition i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.flag(flag),
	.keyout(keyout),
	.reset(reset),
	.swc(swc),
	.swr(swr)
);

// clk
always
begin
	clk = 1'b0;
	clk = #25000 1'b1;
	#25000;
end 

// reset
initial
begin
	reset = 1'b0;
	reset = #1850000 1'b1;
end 
// swc[ 3 ]
initial
begin
	swc[3] = 1'b1;
	swc[3] = #1450000 1'b0;
	swc[3] = #200000 1'b1;
end 
// swc[ 2 ]
initial
begin
	swc[2] = 1'b1;
	swc[2] = #1050000 1'b0;
	swc[2] = #200000 1'b1;
end 
// swc[ 1 ]
initial
begin
	swc[1] = 1'b1;
	swc[1] = #650000 1'b0;
	swc[1] = #200000 1'b1;
end 
// swc[ 0 ]
initial
begin
	swc[0] = 1'b1;
	swc[0] = #250000 1'b0;
	swc[0] = #200000 1'b1;
end 

keyboard_recognition_vlg_sample_tst tb_sample (
	.clk(clk),
	.reset(reset),
	.swc(swc),
	.sampler_tx(sampler)
);

keyboard_recognition_vlg_check_tst tb_out(
	.flag(flag),
	.keyout(keyout),
	.swr(swr),
	.sampler_rx(sampler)
);
endmodule

