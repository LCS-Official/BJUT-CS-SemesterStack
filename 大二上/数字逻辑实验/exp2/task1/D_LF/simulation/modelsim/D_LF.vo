input 	clk;
input 	D;
output 	Q1;
input 	EN;

// Design Ports Information
// Q2	=>  Location: PIN_V12,	 I/O Standard: 2.5 V,	 Current Strength: Default
// Q1	=>  Location: PIN_U12,	 I/O Standard: 2.5 V,	 Current Strength: Default
// D	=>  Location: PIN_AB17,	 I/O Standard: 2.5 V,	 Current Strength: Default
// clk	=>  Location: PIN_AB15,	 I/O Standard: 2.5 V,	 Current Strength: Default
// EN	=>  Location: PIN_AB18,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \Q2~output_o ;
wire \Q1~output_o ;
wire \clk~input_o ;
wire \D~input_o ;
wire \inst2|Q~feeder_combout ;
wire \inst2|Q~q ;
wire \EN~input_o ;
wire \inst3|Q~combout ;


// Location: IOOBUF_X48_Y0_N16
cycloneiii_io_obuf \Q2~output (
	.i(\inst2|Q~q ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\Q2~output_o ),
	.obar());
// synopsys translate_off
defparam \Q2~output .bus_hold = "false";
defparam \Q2~output .open_drain_output = "false";
// synopsys translate_on

// Location: IOOBUF_X52_Y0_N23
cycloneiii_io_obuf \Q1~output (
	.i(\inst3|Q~combout ),
