// synopsys translate_on

// Location: LCCOMB_X51_Y1_N10
cycloneiii_lcell_comb \inst3|Q (
// Equation(s):
// \inst3|Q~combout  = (\EN~input_o  & (\D~input_o )) # (!\EN~input_o  & ((\inst3|Q~combout )))

	.dataa(gnd),
	.datab(\D~input_o ),
	.datac(\EN~input_o ),
	.datad(\inst3|Q~combout ),
	.cin(gnd),
	.combout(\inst3|Q~combout ),
