`timescale 1 ns/ 1 ps
module D_FF_vlg_tst();
reg D;
reg clk;                                 
wire Q;
                      
D_FF i1 (
	.D(D),
	.Q(Q),
	.clk(clk)
);

initial                                                
begin                                                  
	clk = 0;
	D = 0;
	#20 D = 1; 
   #20 D = 0; 
   #20 D = 1; 
   #20 D = 0;
	#100 $stop;
end                                                    
always                                                 
	#10 clk = ~clk;
endmodule