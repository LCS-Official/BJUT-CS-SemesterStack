module reg_8_32_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg reset;
reg [2:0] w_addr;
reg [31:0] w_data;
reg w_r;
// wires                                               
wire [31:0] r_data;

wire sampler;                             

// assign statements (if any)                          
reg_8_32 i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.r_data(r_data),
	.reset(reset),
	.w_addr(w_addr),
	.w_data(w_data),
	.w_r(w_r)
);
// w_addr[ 2 ]
initial
begin
	repeat(2)
	begin
		w_addr[2] = 1'b0;
		w_addr[2] = #400000 1'b1;
		# 400000;
	end
	w_addr[2] = 1'b0;
end 
// w_addr[ 1 ]
always
begin
	w_addr[1] = 1'b0;
	w_addr[1] = #200000 1'b1;
	#200000;
end 
// w_addr[ 0 ]
always
begin
	w_addr[0] = 1'b0;
	w_addr[0] = #100000 1'b1;
	#100000;
end 

// clk
always
begin
	clk = 1'b0;
	clk = #100000 1'b1;
	#100000;
end 

// w_r
initial
begin
	w_r = 1'b1;
	w_r = #800000 1'b0;
	w_r = #800000 1'b1;
end 

// reset
initial
begin
	reset = 1'b1;
	reset = #1600000 1'b0;
end 
// w_data[ 31 ]
initial
begin
	w_data[31] = 1'b0;
end 
