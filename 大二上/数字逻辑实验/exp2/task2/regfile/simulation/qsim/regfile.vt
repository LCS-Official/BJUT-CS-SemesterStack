`timescale 1 ps/ 1 ps
module regfile_vlg_sample_tst(
	clk,
	en1,
	en2,
	en3,
	en4,
	en5,
	en6,
	en7,
	en8,
	in,
	rst_n,
	w_r,
	sampler_tx
);
input  clk;
input  en1;
input  en2;
input  en3;
input  en4;
input  en5;
input  en6;
input  en7;
input  en8;
input [31:0] in;
input  rst_n;
input  w_r;
output sampler_tx;

reg sample;
time current_time;
always @(clk or en1 or en2 or en3 or en4 or en5 or en6 or en7 or en8 or in or rst_n or w_r)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

