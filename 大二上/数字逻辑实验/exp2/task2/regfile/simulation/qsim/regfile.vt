reg clk;
reg en1;
reg en2;
reg en3;
reg en4;
reg en5;
reg en6;
reg en7;
reg en8;
reg [31:0] in;
reg rst_n;
reg w_r;
// wires                                               
wire [31:0] out1;
wire [31:0] out2;
wire [31:0] out3;
wire [31:0] out4;
wire [31:0] out5;
wire [31:0] out6;
wire [31:0] out7;
wire [31:0] out8;

wire sampler;                             

// assign statements (if any)                          
regfile i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.en1(en1),
	.en2(en2),
	.en3(en3),
	.en4(en4),
	.en5(en5),
	.en6(en6),
