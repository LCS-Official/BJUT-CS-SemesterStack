	.out6(out6),
	.out7(out7),
	.out8(out8),
	.rst_n(rst_n),
	.w_r(w_r)
);

// clk
always
begin
	clk = 1'b0;
	clk = #50000 1'b1;
	#50000;
end 

// rst_n
initial
begin
	rst_n = 1'b1;
	rst_n = #1600000 1'b0;
end 

// w_r
initial
begin
	w_r = 1'b0;
	w_r = #800000 1'b1;
	w_r = #800000 1'b0;
	w_r = #100000 1'b1;
	w_r = #100000 1'b0;
end 

