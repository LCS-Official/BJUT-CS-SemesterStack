module distance_1015_vlg_vec_tst();
// constants                                           
// general purpose registers
reg back_trip;
reg clk_hjq;
reg clr_hjq;
reg [1:0] dis_in;
// wires                                               
wire [7:0] distance_result;
wire [7:0] fee_result;

wire sampler;                             

// assign statements (if any)                          
distance_1015 i1 (
// port map - connection between master ports and signals/registers   
	.back_trip(back_trip),
	.clk_hjq(clk_hjq),
	.clr_hjq(clr_hjq),
	.dis_in(dis_in),
	.distance_result(distance_result),
	.fee_result(fee_result)
);

// clk_hjq
always
begin
	clk_hjq = 1'b0;
	clk_hjq = #10000 1'b1;
	#10000;
end 

// back_trip
initial
begin
	back_trip = 1'b0;
	back_trip = #440000 1'b1;
	back_trip = #30000 1'b0;
end 

// clr_hjq
initial
begin
	clr_hjq = 1'b0;
end 
// dis_in[ 1 ]
initial
begin
	dis_in[1] = 1'b1;
	dis_in[1] = #100000 1'b0;
	dis_in[1] = #20000 1'b1;
	dis_in[1] = #60000 1'b0;
	dis_in[1] = #60000 1'b1;
	dis_in[1] = #260000 1'b0;
	dis_in[1] = #20000 1'b1;
end 
// dis_in[ 0 ]
initial
begin
	dis_in[0] = 1'b1;
	dis_in[0] = #20000 1'b0;
	dis_in[0] = #20000 1'b1;
	dis_in[0] = #20000 1'b0;
	dis_in[0] = #20000 1'b1;
	dis_in[0] = #60000 1'b0;
	dis_in[0] = #20000 1'b1;
	dis_in[0] = #130000 1'b0;
	dis_in[0] = #70000 1'b1;
end 

distance_1015_vlg_sample_tst tb_sample (
	.back_trip(back_trip),
	.clk_hjq(clk_hjq),
	.clr_hjq(clr_hjq),
	.dis_in(dis_in),
	.sampler_tx(sampler)
);

distance_1015_vlg_check_tst tb_out(
	.distance_result(distance_result),
	.fee_result(fee_result),
	.sampler_rx(sampler)
);
endmodule

