reg [7:0] change_out;
reg [7:0] distance_out;
reg [7:0] fee_out;
reg n_en;
reg [2:0] sel_hjq;
reg [7:0] vendingmachine_out;
// wires                                               
wire [3:0] out;

wire sampler;                             

// assign statements (if any)                          
display_selector_1015 i1 (
// port map - connection between master ports and signals/registers   
	.change_out(change_out),
	.distance_out(distance_out),
