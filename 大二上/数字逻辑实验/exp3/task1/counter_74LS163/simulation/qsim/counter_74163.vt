// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "11/11/2024 15:03:14"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    counter_74163
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module counter_74163_vlg_sample_tst(
	Q_in,
	clk,
	clrn,
	enp,
	ent,
	ldn,
	sampler_tx
);
input [3:0] Q_in;
input  clk;
input  clrn;
input  enp;
input  ent;
input  ldn;
output sampler_tx;

reg sample;
time current_time;
always @(Q_in or clk or clrn or enp or ent or ldn)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module counter_74163_vlg_check_tst (
	Q_out,
	rco,
	sampler_rx
);
input [3:0] Q_out;
input  rco;
input sampler_rx;

reg [3:0] Q_out_expected;
reg  rco_expected;

reg [3:0] Q_out_prev;
reg  rco_prev;

reg [3:0] Q_out_expected_prev;
reg  rco_expected_prev;

reg [3:0] last_Q_out_exp;
reg  last_rco_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:2] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 2'b1;
end

// update real /o prevs

always @(trigger)
begin
	Q_out_prev = Q_out;
	rco_prev = rco;
end

// update expected /o prevs

always @(trigger)
begin
	Q_out_expected_prev = Q_out_expected;
	rco_expected_prev = rco_expected;
end



// expected rco
initial
begin
	rco_expected = 1'bX;
	rco_expected = #999000 1'b0;
end 
// expected Q_out[ 3 ]
initial
begin
	Q_out_expected[3] = 1'bX;
	Q_out_expected[3] = #999000 1'b0;
end 
// expected Q_out[ 2 ]
initial
begin
	Q_out_expected[2] = 1'bX;
	Q_out_expected[2] = #999000 1'b0;
end 
// expected Q_out[ 1 ]
initial
begin
	Q_out_expected[1] = 1'bX;
	Q_out_expected[1] = #999000 1'b0;
end 
// expected Q_out[ 0 ]
initial
begin
	Q_out_expected[0] = 1'bX;
	Q_out_expected[0] = #999000 1'b0;
end 
// generate trigger
always @(Q_out_expected or Q_out or rco_expected or rco)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected Q_out = %b | expected rco = %b | ",Q_out_expected_prev,rco_expected_prev);
	$display("| real Q_out = %b | real rco = %b | ",Q_out_prev,rco_prev);
`endif
	if (
		( Q_out_expected_prev[0] !== 1'bx ) && ( Q_out_prev[0] !== Q_out_expected_prev[0] )
		&& ((Q_out_expected_prev[0] !== last_Q_out_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q_out[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q_out_expected_prev);
		$display ("     Real value = %b", Q_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Q_out_exp[0] = Q_out_expected_prev[0];
	end
	if (
		( Q_out_expected_prev[1] !== 1'bx ) && ( Q_out_prev[1] !== Q_out_expected_prev[1] )
		&& ((Q_out_expected_prev[1] !== last_Q_out_exp[1]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q_out[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q_out_expected_prev);
		$display ("     Real value = %b", Q_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Q_out_exp[1] = Q_out_expected_prev[1];
	end
	if (
		( Q_out_expected_prev[2] !== 1'bx ) && ( Q_out_prev[2] !== Q_out_expected_prev[2] )
		&& ((Q_out_expected_prev[2] !== last_Q_out_exp[2]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q_out[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q_out_expected_prev);
		$display ("     Real value = %b", Q_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Q_out_exp[2] = Q_out_expected_prev[2];
	end
	if (
		( Q_out_expected_prev[3] !== 1'bx ) && ( Q_out_prev[3] !== Q_out_expected_prev[3] )
		&& ((Q_out_expected_prev[3] !== last_Q_out_exp[3]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q_out[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q_out_expected_prev);
		$display ("     Real value = %b", Q_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Q_out_exp[3] = Q_out_expected_prev[3];
	end
	if (
		( rco_expected_prev !== 1'bx ) && ( rco_prev !== rco_expected_prev )
		&& ((rco_expected_prev !== last_rco_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port rco :: @time = %t",  $realtime);
		$display ("     Expected value = %b", rco_expected_prev);
		$display ("     Real value = %b", rco_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_rco_exp = rco_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1700000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module counter_74163_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [3:0] Q_in;
reg clk;
reg clrn;
reg enp;
reg ent;
reg ldn;
// wires                                               
wire [3:0] Q_out;
wire rco;

wire sampler;                             

// assign statements (if any)                          
counter_74163 i1 (
// port map - connection between master ports and signals/registers   
	.Q_in(Q_in),
	.Q_out(Q_out),
	.clk(clk),
	.clrn(clrn),
	.enp(enp),
	.ent(ent),
	.ldn(ldn),
	.rco(rco)
);
// Q_in[ 3 ]
initial
begin
	Q_in[3] = 1'b0;
	Q_in[3] = #900000 1'b1;
	Q_in[3] = #200000 1'b0;
end 
// Q_in[ 2 ]
initial
begin
	Q_in[2] = 1'b0;
	Q_in[2] = #900000 1'b1;
	Q_in[2] = #200000 1'b0;
end 
// Q_in[ 1 ]
initial
begin
	Q_in[1] = 1'b0;
	Q_in[1] = #900000 1'b1;
	Q_in[1] = #200000 1'b0;
end 
// Q_in[ 0 ]
initial
begin
	Q_in[0] = 1'b1;
end 

// clk
always
begin
	clk = 1'b0;
	clk = #50000 1'b1;
	#50000;
end 

// clrn
initial
begin
	clrn = 1'b1;
	clrn = #800000 1'b0;
	clrn = #100000 1'b1;
	clrn = #200000 1'b0;
end 

// ldn
initial
begin
	ldn = 1'b0;
	ldn = #100000 1'b1;
	ldn = #700000 1'b0;
	ldn = #200000 1'b1;
	ldn = #100000 1'b0;
end 

// enp
initial
begin
	enp = 1'b0;
	enp = #100000 1'b1;
	enp = #500000 1'b0;
end 

// ent
initial
begin
	ent = 1'b0;
	ent = #100000 1'b1;
	ent = #400000 1'b0;
	ent = #100000 1'b1;
	ent = #100000 1'b0;
	ent = #300000 1'b1;
	ent = #100000 1'b0;
end 

counter_74163_vlg_sample_tst tb_sample (
	.Q_in(Q_in),
	.clk(clk),
	.clrn(clrn),
	.enp(enp),
	.ent(ent),
	.ldn(ldn),
	.sampler_tx(sampler)
);

counter_74163_vlg_check_tst tb_out(
	.Q_out(Q_out),
	.rco(rco),
	.sampler_rx(sampler)
);
endmodule

