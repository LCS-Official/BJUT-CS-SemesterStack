// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "11/11/2024 21:37:34"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    frequency_divider_new
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module frequency_divider_new_vlg_sample_tst(
	clk_50mhz,
	clr_n,
	enp,
	ent,
	ld_n,
	q_in,
	rst,
	sampler_tx
);
input  clk_50mhz;
input  clr_n;
input  enp;
input  ent;
input  ld_n;
input [3:0] q_in;
input  rst;
output sampler_tx;

reg sample;
time current_time;
always @(clk_50mhz or clr_n or enp or ent or ld_n or q_in or rst)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module frequency_divider_new_vlg_check_tst (
	clk_1hz,
	clk_10hz,
	clk_100hz,
	clk_1000hz,
	q_out,
	rco,
	sampler_rx
);
input  clk_1hz;
input  clk_10hz;
input  clk_100hz;
input  clk_1000hz;
input [3:0] q_out;
input  rco;
input sampler_rx;

reg  clk_1hz_expected;
reg  clk_10hz_expected;
reg  clk_100hz_expected;
reg  clk_1000hz_expected;
reg [3:0] q_out_expected;
reg  rco_expected;

reg  clk_1hz_prev;
reg  clk_10hz_prev;
reg  clk_100hz_prev;
reg  clk_1000hz_prev;
reg [3:0] q_out_prev;
reg  rco_prev;

reg  clk_1hz_expected_prev;
reg  clk_10hz_expected_prev;
reg  clk_100hz_expected_prev;
reg  clk_1000hz_expected_prev;
reg [3:0] q_out_expected_prev;
reg  rco_expected_prev;

reg  last_clk_1hz_exp;
reg  last_clk_10hz_exp;
reg  last_clk_100hz_exp;
reg  last_clk_1000hz_exp;
reg [3:0] last_q_out_exp;
reg  last_rco_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:6] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 6'b1;
end

// update real /o prevs

always @(trigger)
begin
	clk_1hz_prev = clk_1hz;
	clk_10hz_prev = clk_10hz;
	clk_100hz_prev = clk_100hz;
	clk_1000hz_prev = clk_1000hz;
	q_out_prev = q_out;
	rco_prev = rco;
end

// update expected /o prevs

always @(trigger)
begin
	clk_1hz_expected_prev = clk_1hz_expected;
	clk_10hz_expected_prev = clk_10hz_expected;
	clk_100hz_expected_prev = clk_100hz_expected;
	clk_1000hz_expected_prev = clk_1000hz_expected;
	q_out_expected_prev = q_out_expected;
	rco_expected_prev = rco_expected;
end



// expected clk_1hz
initial
begin
	clk_1hz_expected = 1'bX;
	clk_1hz_expected = #999000 1'b0;
end 

// expected clk_10hz
initial
begin
	clk_10hz_expected = 1'bX;
	clk_10hz_expected = #999000 1'b0;
end 

// expected clk_100hz
initial
begin
	clk_100hz_expected = 1'bX;
	clk_100hz_expected = #999000 1'b0;
end 

// expected clk_1000hz
initial
begin
	clk_1000hz_expected = 1'bX;
	clk_1000hz_expected = #999000 1'b0;
end 

// expected rco
initial
begin
	rco_expected = 1'bX;
	rco_expected = #999000 1'b0;
end 
// expected q_out[ 3 ]
initial
begin
	q_out_expected[3] = 1'bX;
	q_out_expected[3] = #999000 1'b0;
end 
// expected q_out[ 2 ]
initial
begin
	q_out_expected[2] = 1'bX;
	q_out_expected[2] = #999000 1'b0;
end 
// expected q_out[ 1 ]
initial
begin
	q_out_expected[1] = 1'bX;
	q_out_expected[1] = #999000 1'b0;
end 
// expected q_out[ 0 ]
initial
begin
	q_out_expected[0] = 1'bX;
	q_out_expected[0] = #999000 1'b0;
end 
// generate trigger
always @(clk_1hz_expected or clk_1hz or clk_10hz_expected or clk_10hz or clk_100hz_expected or clk_100hz or clk_1000hz_expected or clk_1000hz or q_out_expected or q_out or rco_expected or rco)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected clk_1hz = %b | expected clk_10hz = %b | expected clk_100hz = %b | expected clk_1000hz = %b | expected q_out = %b | expected rco = %b | ",clk_1hz_expected_prev,clk_10hz_expected_prev,clk_100hz_expected_prev,clk_1000hz_expected_prev,q_out_expected_prev,rco_expected_prev);
	$display("| real clk_1hz = %b | real clk_10hz = %b | real clk_100hz = %b | real clk_1000hz = %b | real q_out = %b | real rco = %b | ",clk_1hz_prev,clk_10hz_prev,clk_100hz_prev,clk_1000hz_prev,q_out_prev,rco_prev);
`endif
	if (
		( clk_1hz_expected_prev !== 1'bx ) && ( clk_1hz_prev !== clk_1hz_expected_prev )
		&& ((clk_1hz_expected_prev !== last_clk_1hz_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port clk_1hz :: @time = %t",  $realtime);
		$display ("     Expected value = %b", clk_1hz_expected_prev);
		$display ("     Real value = %b", clk_1hz_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_clk_1hz_exp = clk_1hz_expected_prev;
	end
	if (
		( clk_10hz_expected_prev !== 1'bx ) && ( clk_10hz_prev !== clk_10hz_expected_prev )
		&& ((clk_10hz_expected_prev !== last_clk_10hz_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port clk_10hz :: @time = %t",  $realtime);
		$display ("     Expected value = %b", clk_10hz_expected_prev);
		$display ("     Real value = %b", clk_10hz_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_clk_10hz_exp = clk_10hz_expected_prev;
	end
	if (
		( clk_100hz_expected_prev !== 1'bx ) && ( clk_100hz_prev !== clk_100hz_expected_prev )
		&& ((clk_100hz_expected_prev !== last_clk_100hz_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port clk_100hz :: @time = %t",  $realtime);
		$display ("     Expected value = %b", clk_100hz_expected_prev);
		$display ("     Real value = %b", clk_100hz_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_clk_100hz_exp = clk_100hz_expected_prev;
	end
	if (
		( clk_1000hz_expected_prev !== 1'bx ) && ( clk_1000hz_prev !== clk_1000hz_expected_prev )
		&& ((clk_1000hz_expected_prev !== last_clk_1000hz_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port clk_1000hz :: @time = %t",  $realtime);
		$display ("     Expected value = %b", clk_1000hz_expected_prev);
		$display ("     Real value = %b", clk_1000hz_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_clk_1000hz_exp = clk_1000hz_expected_prev;
	end
	if (
		( q_out_expected_prev[0] !== 1'bx ) && ( q_out_prev[0] !== q_out_expected_prev[0] )
		&& ((q_out_expected_prev[0] !== last_q_out_exp[0]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port q_out[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", q_out_expected_prev);
		$display ("     Real value = %b", q_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_q_out_exp[0] = q_out_expected_prev[0];
	end
	if (
		( q_out_expected_prev[1] !== 1'bx ) && ( q_out_prev[1] !== q_out_expected_prev[1] )
		&& ((q_out_expected_prev[1] !== last_q_out_exp[1]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port q_out[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", q_out_expected_prev);
		$display ("     Real value = %b", q_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_q_out_exp[1] = q_out_expected_prev[1];
	end
	if (
		( q_out_expected_prev[2] !== 1'bx ) && ( q_out_prev[2] !== q_out_expected_prev[2] )
		&& ((q_out_expected_prev[2] !== last_q_out_exp[2]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port q_out[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", q_out_expected_prev);
		$display ("     Real value = %b", q_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_q_out_exp[2] = q_out_expected_prev[2];
	end
	if (
		( q_out_expected_prev[3] !== 1'bx ) && ( q_out_prev[3] !== q_out_expected_prev[3] )
		&& ((q_out_expected_prev[3] !== last_q_out_exp[3]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port q_out[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", q_out_expected_prev);
		$display ("     Real value = %b", q_out_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_q_out_exp[3] = q_out_expected_prev[3];
	end
	if (
		( rco_expected_prev !== 1'bx ) && ( rco_prev !== rco_expected_prev )
		&& ((rco_expected_prev !== last_rco_exp) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port rco :: @time = %t",  $realtime);
		$display ("     Expected value = %b", rco_expected_prev);
		$display ("     Real value = %b", rco_prev);
		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_rco_exp = rco_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1800000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module frequency_divider_new_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk_50mhz;
reg clr_n;
reg enp;
reg ent;
reg ld_n;
reg [3:0] q_in;
reg rst;
// wires                                               
wire clk_1hz;
wire clk_10hz;
wire clk_100hz;
wire clk_1000hz;
wire [3:0] q_out;
wire rco;

wire sampler;                             

// assign statements (if any)                          
frequency_divider_new i1 (
// port map - connection between master ports and signals/registers   
	.clk_1hz(clk_1hz),
	.clk_10hz(clk_10hz),
	.clk_50mhz(clk_50mhz),
	.clk_100hz(clk_100hz),
	.clk_1000hz(clk_1000hz),
	.clr_n(clr_n),
	.enp(enp),
	.ent(ent),
	.ld_n(ld_n),
	.q_in(q_in),
	.q_out(q_out),
	.rco(rco),
	.rst(rst)
);

// clr_n
initial
begin
	clr_n = 1'b1;
	clr_n = #1200000 1'b0;
	clr_n = #50000 1'b1;
end 

// ld_n
initial
begin
	ld_n = 1'b1;
	ld_n = #1650000 1'b0;
end 

// ent
initial
begin
	ent = 1'b1;
end 

// clk_50mhz
always
begin
	clk_50mhz = 1'b0;
	clk_50mhz = #10000 1'b1;
	#10000;
end 

// enp
initial
begin
	enp = 1'b1;
end 

// rst
initial
begin
	rst = 1'b1;
	rst = #600000 1'b0;
	rst = #100000 1'b1;
end 
// q_in[ 3 ]
initial
begin
	q_in[3] = 1'b0;
	q_in[3] = #400000 1'b1;
	q_in[3] = #400000 1'b0;
	q_in[3] = #400000 1'b1;
end 
// q_in[ 2 ]
initial
begin
	repeat(3)
	begin
		q_in[2] = 1'b0;
		q_in[2] = #200000 1'b1;
		# 200000;
	end
	q_in[2] = 1'b0;
	q_in[2] = #200000 1'b1;
end 
// q_in[ 1 ]
initial
begin
	repeat(7)
	begin
		q_in[1] = 1'b0;
		q_in[1] = #100000 1'b1;
		# 100000;
	end
	q_in[1] = 1'b0;
	q_in[1] = #100000 1'b1;
end 
// q_in[ 0 ]
initial
begin
	repeat(15)
	begin
		q_in[0] = 1'b0;
		q_in[0] = #50000 1'b1;
		# 50000;
	end
	q_in[0] = 1'b0;
	q_in[0] = #50000 1'b1;
end 

frequency_divider_new_vlg_sample_tst tb_sample (
	.clk_50mhz(clk_50mhz),
	.clr_n(clr_n),
	.enp(enp),
	.ent(ent),
	.ld_n(ld_n),
	.q_in(q_in),
	.rst(rst),
	.sampler_tx(sampler)
);

frequency_divider_new_vlg_check_tst tb_out(
	.clk_1hz(clk_1hz),
	.clk_10hz(clk_10hz),
	.clk_100hz(clk_100hz),
	.clk_1000hz(clk_1000hz),
	.q_out(q_out),
	.rco(rco),
	.sampler_rx(sampler)
);
endmodule

