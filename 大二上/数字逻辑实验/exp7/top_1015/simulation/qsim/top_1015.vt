module top_1015_vlg_vec_tst();
// constants                                           
// general purpose registers
reg bill_10;
reg bill_50;
reg clk_50mhz_hjq;
reg coin_1;
reg coin_5;
reg coin_10;
reg confirm;
reg [4:0] dis_in;
reg n_en;
// wires                                               
wire [7:0] ds_hjq;
wire insufficient;
wire [6:0] LED_out;

wire sampler;                             

// assign statements (if any)                          
top_1015 i1 (
// port map - connection between master ports and signals/registers   
	.bill_10(bill_10),
	.bill_50(bill_50),
	.clk_50mhz_hjq(clk_50mhz_hjq),
	.coin_1(coin_1),
	.coin_5(coin_5),
	.coin_10(coin_10),
	.confirm(confirm),
	.dis_in(dis_in),
	.ds_hjq(ds_hjq),
	.insufficient(insufficient),
	.LED_out(LED_out),
	.n_en(n_en)
);

// clk_50mhz_hjq
always
begin
	clk_50mhz_hjq = 1'b0;
	clk_50mhz_hjq = #5000 1'b1;
	#5000;
end 

// n_en
initial
begin
	n_en = 1'b0;
end 

// bill_10
initial
begin
	bill_10 = 1'b0;
	bill_10 = #30000 1'b1;
	bill_10 = #10000 1'b0;
end 

// bill_50
initial
begin
	bill_50 = 1'b0;
end 

// coin_1
initial
begin
	coin_1 = 1'b0;
end 

// coin_5
initial
begin
	coin_5 = 1'b0;
end 

// coin_10
initial
begin
	coin_10 = 1'b0;
end 

// confirm
initial
begin
	confirm = 1'b0;
	confirm = #60000 1'b1;
	confirm = #10000 1'b0;
end 
// dis_in[ 4 ]
initial
begin
	dis_in[4] = 1'b0;
end 
// dis_in[ 3 ]
initial
begin
	dis_in[3] = 1'b0;
end 
// dis_in[ 2 ]
initial
begin
	dis_in[2] = 1'b0;
end 
// dis_in[ 1 ]
initial
begin
	dis_in[1] = 1'b0;
end 
// dis_in[ 0 ]
initial
begin
	dis_in[0] = 1'b0;
end 

top_1015_vlg_sample_tst tb_sample (
	.bill_10(bill_10),
	.bill_50(bill_50),
	.clk_50mhz_hjq(clk_50mhz_hjq),
	.coin_1(coin_1),
	.coin_5(coin_5),
	.coin_10(coin_10),
	.confirm(confirm),
	.dis_in(dis_in),
	.n_en(n_en),
	.sampler_tx(sampler)
);

top_1015_vlg_check_tst tb_out(
	.ds_hjq(ds_hjq),
	.insufficient(insufficient),
	.LED_out(LED_out),
	.sampler_rx(sampler)
);
endmodule

