// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "12/04/2024 21:57:22"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    top_1015
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module top_1015_vlg_sample_tst(
	bill_10,
	bill_50,
	clk_50mhz_hjq,
	coin_1,
	coin_5,
	coin_10,
	confirm,
	dis_in,
	n_en,
	sampler_tx
);
input  bill_10;
input  bill_50;
input  clk_50mhz_hjq;
input  coin_1;
input  coin_5;
input  coin_10;
input  confirm;
input [4:0] dis_in;
input  n_en;
output sampler_tx;

reg sample;
time current_time;
always @(bill_10 or bill_50 or clk_50mhz_hjq or coin_1 or coin_5 or coin_10 or confirm or dis_in or n_en)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module top_1015_vlg_check_tst (
	ds_hjq,
	insufficient,
	LED_out,
	sampler_rx
);
input [7:0] ds_hjq;
input  insufficient;
input [6:0] LED_out;
input sampler_rx;

reg [7:0] ds_hjq_expected;
reg  insufficient_expected;
reg [6:0] LED_out_expected;

reg [7:0] ds_hjq_prev;
reg  insufficient_prev;
reg [6:0] LED_out_prev;

reg [7:0] ds_hjq_expected_prev;
reg  insufficient_expected_prev;
reg [6:0] LED_out_expected_prev;

reg [7:0] last_ds_hjq_exp;
reg  last_insufficient_exp;
reg [6:0] last_LED_out_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:3] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 3'b1;
end

// update real /o prevs

always @(trigger)
begin
	ds_hjq_prev = ds_hjq;
	insufficient_prev = insufficient;
	LED_out_prev = LED_out;
end

// update expected /o prevs

always @(trigger)
begin
	ds_hjq_expected_prev = ds_hjq_expected;
	insufficient_expected_prev = insufficient_expected;
	LED_out_expected_prev = LED_out_expected;
end


// expected ds_hjq[ 7 ]
initial
begin
	ds_hjq_expected[7] = 1'bX;
end 
// expected ds_hjq[ 6 ]
initial
begin
	ds_hjq_expected[6] = 1'bX;
end 
// expected ds_hjq[ 5 ]
