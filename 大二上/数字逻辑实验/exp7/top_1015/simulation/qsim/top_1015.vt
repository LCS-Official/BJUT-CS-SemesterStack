	LED_out_expected[2] = 1'bX;
end 
// expected LED_out[ 1 ]
initial
begin
	LED_out_expected[1] = 1'bX;
end 
// expected LED_out[ 0 ]
initial
begin
	LED_out_expected[0] = 1'bX;
end 

// expected insufficient
initial
begin
	insufficient_expected = 1'bX;
end 
// generate trigger
always @(ds_hjq_expected or ds_hjq or insufficient_expected or insufficient or LED_out_expected or LED_out)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected ds_hjq = %b | expected insufficient = %b | expected LED_out = %b | ",ds_hjq_expected_prev,insufficient_expected_prev,LED_out_expected_prev);
	$display("| real ds_hjq = %b | real insufficient = %b | real LED_out = %b | ",ds_hjq_prev,insufficient_prev,LED_out_prev);
`endif
	if (
		( ds_hjq_expected_prev[0] !== 1'bx ) && ( ds_hjq_prev[0] !== ds_hjq_expected_prev[0] )
		&& ((ds_hjq_expected_prev[0] !== last_ds_hjq_exp[0]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ds_hjq[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ds_hjq_expected_prev);
		$display ("     Real value = %b", ds_hjq_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ds_hjq_exp[0] = ds_hjq_expected_prev[0];
	end
