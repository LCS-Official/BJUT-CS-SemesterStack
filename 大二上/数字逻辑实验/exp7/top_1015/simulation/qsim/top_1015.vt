		$display ("     Real value = %b", ds_hjq_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ds_hjq_exp[5] = ds_hjq_expected_prev[5];
	end
	if (
		( ds_hjq_expected_prev[6] !== 1'bx ) && ( ds_hjq_prev[6] !== ds_hjq_expected_prev[6] )
		&& ((ds_hjq_expected_prev[6] !== last_ds_hjq_exp[6]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ds_hjq[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ds_hjq_expected_prev);
		$display ("     Real value = %b", ds_hjq_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ds_hjq_exp[6] = ds_hjq_expected_prev[6];
	end
	if (
		( ds_hjq_expected_prev[7] !== 1'bx ) && ( ds_hjq_prev[7] !== ds_hjq_expected_prev[7] )
		&& ((ds_hjq_expected_prev[7] !== last_ds_hjq_exp[7]) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port ds_hjq[7] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", ds_hjq_expected_prev);
		$display ("     Real value = %b", ds_hjq_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_ds_hjq_exp[7] = ds_hjq_expected_prev[7];
	end
	if (
		( insufficient_expected_prev !== 1'bx ) && ( insufficient_prev !== insufficient_expected_prev )
		&& ((insufficient_expected_prev !== last_insufficient_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port insufficient :: @time = %t",  $realtime);
		$display ("     Expected value = %b", insufficient_expected_prev);
		$display ("     Real value = %b", insufficient_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_insufficient_exp = insufficient_expected_prev;
	end
	if (
		( LED_out_expected_prev[0] !== 1'bx ) && ( LED_out_prev[0] !== LED_out_expected_prev[0] )
		&& ((LED_out_expected_prev[0] !== last_LED_out_exp[0]) ||
