`timescale 1 ps/ 1 ps
module vending_machine_1015_vlg_sample_tst(
	bill_10,
	bill_50,
	bill_100,
	clk_hjq,
	coin_1,
	coin_5,
	coin_10,
	confirm,
	sampler_tx
);
input  bill_10;
input  bill_50;
input  bill_100;
input  clk_hjq;
input  coin_1;
input  coin_5;
input  coin_10;
input  confirm;
output sampler_tx;

reg sample;
time current_time;
always @(bill_10 or bill_50 or bill_100 or clk_hjq or coin_1 or coin_5 or coin_10 or confirm)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

