module vending_machine_1015_vlg_vec_tst();
// constants                                           
// general purpose registers
reg bill_10;
reg bill_50;
reg bill_100;
reg clk_hjq;
reg coin_1;
reg coin_5;
reg coin_10;
reg confirm;
// wires                                               
wire [15:0] total;

wire sampler;                             

// assign statements (if any)                          
vending_machine_1015 i1 (
// port map - connection between master ports and signals/registers   
	.bill_10(bill_10),
	.bill_50(bill_50),
	.bill_100(bill_100),
	.clk_hjq(clk_hjq),
	.coin_1(coin_1),
	.coin_5(coin_5),
	.coin_10(coin_10),
	.confirm(confirm),
	.total(total)
);

// clk_hjq
always
begin
	clk_hjq = 1'b0;
	clk_hjq = #5000 1'b1;
	#5000;
end 

// bill_10
initial
begin
	bill_10 = 1'b0;
end 

// bill_50
initial
begin
	bill_50 = 1'b0;
	bill_50 = #70000 1'b1;
	bill_50 = #10000 1'b0;
end 

// bill_100
initial
begin
	bill_100 = 1'b0;
	bill_100 = #30000 1'b1;
	bill_100 = #10000 1'b0;
	bill_100 = #10000 1'b1;
	bill_100 = #10000 1'b0;
end 

// coin_1
initial
begin
	coin_1 = 1'b0;
end 

// coin_5
initial
begin
	coin_5 = 1'b0;
end 

// coin_10
initial
begin
	coin_10 = 1'b0;
end 

// confirm
initial
begin
	confirm = 1'b0;
	confirm = #110000 1'b1;
	confirm = #10000 1'b0;
end 

vending_machine_1015_vlg_sample_tst tb_sample (
	.bill_10(bill_10),
	.bill_50(bill_50),
	.bill_100(bill_100),
	.clk_hjq(clk_hjq),
	.coin_1(coin_1),
	.coin_5(coin_5),
	.coin_10(coin_10),
	.confirm(confirm),
	.sampler_tx(sampler)
);

vending_machine_1015_vlg_check_tst tb_out(
	.total(total),
	.sampler_rx(sampler)
);
endmodule

